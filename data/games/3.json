{"game":{"display_name":"予選ラウンド2","duration_seconds":173700,"game_id":3,"game_type":"multiplayer","is_public":true,"main_players":[],"problem":{"description":"「いろはにほへとちりぬるを」の12種類の文字から構成される文字列が改行区切りで入力されます。標準入力の内容を全て読み取り、文字列を「いろは」順に並べて出力してください。\n\n入力:\nるりいろ\nりぬる\nいちにち\nほへとちに\nいち\nほとはろ\nりにへ\nいい\nいいい\nとりほい\nいろ\nいろいろ\n\n出力:\nいい\nいいい\nいろ\nいろいろ\nいち\nいちにち\nるりいろ\nほへとちに\nほとはろ\nとりほい\nりにへ\nりぬる\n","problem_id":3,"sample_code":"$lines = [];\nwhile ($line = fgets(STDIN)) {\n    $lines[] = rtrim($line);\n}\n$iroha_order = array_flip(mb_str_split(\"いろはにほへとちりぬるを\"));\nusort($lines, function ($a, $b) use ($iroha_order) {\n    $len = min(mb_strlen($a), mb_strlen($b));\n    for ($i = 0; $i < $len; $i++) {\n        $ca = mb_substr($a, $i, 1);\n        $cb = mb_substr($b, $i, 1);\n        if ($ca !== $cb) {\n            return $iroha_order[$ca] - $iroha_order[$cb];\n        }\n    }\n    return mb_strlen($a) - mb_strlen($b);\n});\n\nforeach ($lines as $line) echo $line, PHP_EOL;\n","title":"いろは","sample_code_html":"<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E\">$lines </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">while</span><span style=\"color:#24292E\"> ($line </span><span style=\"color:#D73A49\">=</span><span style=\"color:#005CC5\"> fgets</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">STDIN</span><span style=\"color:#24292E\">)) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    $lines[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#005CC5\"> rtrim</span><span style=\"color:#24292E\">($line);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">$iroha_order </span><span style=\"color:#D73A49\">=</span><span style=\"color:#005CC5\"> array_flip</span><span style=\"color:#24292E\">(</span><span style=\"color:#6F42C1\">mb_str_split</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">\"いろはにほへとちりぬるを\"</span><span style=\"color:#24292E\">));</span></span>\n<span class=\"line\"><span style=\"color:#005CC5\">usort</span><span style=\"color:#24292E\">($lines, </span><span style=\"color:#D73A49\">function</span><span style=\"color:#24292E\"> ($a, $b) </span><span style=\"color:#D73A49\">use</span><span style=\"color:#24292E\"> ($iroha_order) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    $len </span><span style=\"color:#D73A49\">=</span><span style=\"color:#005CC5\"> min</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">mb_strlen</span><span style=\"color:#24292E\">($a), </span><span style=\"color:#005CC5\">mb_strlen</span><span style=\"color:#24292E\">($b));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    for</span><span style=\"color:#24292E\"> ($i </span><span style=\"color:#D73A49\">=</span><span style=\"color:#005CC5\"> 0</span><span style=\"color:#24292E\">; $i </span><span style=\"color:#D73A49\">&#x3C;</span><span style=\"color:#24292E\"> $len; $i</span><span style=\"color:#D73A49\">++</span><span style=\"color:#24292E\">) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        $ca </span><span style=\"color:#D73A49\">=</span><span style=\"color:#005CC5\"> mb_substr</span><span style=\"color:#24292E\">($a, $i, </span><span style=\"color:#005CC5\">1</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        $cb </span><span style=\"color:#D73A49\">=</span><span style=\"color:#005CC5\"> mb_substr</span><span style=\"color:#24292E\">($b, $i, </span><span style=\"color:#005CC5\">1</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">        if</span><span style=\"color:#24292E\"> ($ca </span><span style=\"color:#D73A49\">!==</span><span style=\"color:#24292E\"> $cb) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">            return</span><span style=\"color:#24292E\"> $iroha_order[$ca] </span><span style=\"color:#D73A49\">-</span><span style=\"color:#24292E\"> $iroha_order[$cb];</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    return</span><span style=\"color:#005CC5\"> mb_strlen</span><span style=\"color:#24292E\">($a) </span><span style=\"color:#D73A49\">-</span><span style=\"color:#005CC5\"> mb_strlen</span><span style=\"color:#24292E\">($b);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">});</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">foreach</span><span style=\"color:#24292E\"> ($lines </span><span style=\"color:#D73A49\">as</span><span style=\"color:#24292E\"> $line) </span><span style=\"color:#005CC5\">echo</span><span style=\"color:#24292E\"> $line, </span><span style=\"color:#005CC5\">PHP_EOL</span><span style=\"color:#24292E\">;</span></span></code></pre>"},"started_at":1742553948}}
